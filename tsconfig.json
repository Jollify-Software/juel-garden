{
    "compilerOptions": {
        "module": "commonjs",
        "noImplicitAny": false,
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "target": "es2020",
        "experimentalDecorators": true,
        "useDefineForClassFields": false
    },
    "exclude": ["node_modules", "tests/unit"]
}
