{
  "name": "juel-garden",
  "version": "1.0.0",
  "description": "A-Frame inspired custom element library for BabylonJS",
  "module": "lib/juel-garden.mjs",
  "types": "lib/types/juel-garden.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/juel-garden.d.ts",
      "import": "./lib/juel-garden.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "files": [
    "lib",
    "dist",
    "src",
    "juel-garden.ts",
    "juel-garden.global.ts",
    "tsconfig.json",
    "tsconfig.lib.json"
  ],
  "scripts": {
    "dev": "esbuild juel-garden.global.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=dist/juel-garden.js --log-level=warning && npm run copy-wasm && npm run copy-decoders",
    "build": "esbuild juel-garden.global.ts --bundle --minify --format=iife --global-name=JuelGarden --platform=browser --target=es2020 --outfile=dist/juel-garden.js --log-level=warning && npm run copy-wasm && npm run copy-decoders",
    "build:lib": "esbuild juel-garden.ts --bundle --format=esm --packages=external --platform=browser --target=es2020 --sourcemap --outfile=lib/juel-garden.mjs --log-level=warning && tsc -p tsconfig.lib.json",
    "build:lean": "esbuild juel-garden.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=dist/juel-garden.lean.js --log-level=warning",
    "prepare": "npm run build:lib",
    "examples": "http-server . -o /examples/ -c-1",
    "doc": "typedoc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "copy-wasm": "node -e \"require('fs').copyFileSync('node_modules/@babylonjs/havok/lib/esm/HavokPhysics.wasm','dist/HavokPhysics.wasm')\"",
    "test:physics": "node tests/physics-zero-g.js",
    "test:link": "node tests/link.js",
    "test:model": "node tests/model.js",
    "copy-decoders": "node -e \"const fs=require('fs');fs.mkdirSync('dist/decoders',{recursive:true});for(const f of fs.readdirSync('vendor/decoders'))if(!f.endsWith('.md'))fs.copyFileSync('vendor/decoders/'+f,'dist/decoders/'+f)\"",
    "test:polygon": "node tests/polygon.js",
    "test:polygon-winding": "node tests/polygon-winding.js",
    "test:parterre-polygon": "node tests/parterre-polygon.js",
    "test:rotunda": "node tests/rotunda.js",
    "test:stairs": "node tests/stairs.js",
    "test:spec-colour": "node tests/spec-colour.js",
    "test:particles": "node tests/particles.js",
    "test:parterre-stairs": "node tests/parterre-stairs.js",
    "test:examples": "node tests/examples.js",
    "test:lean": "npm run build:lean && node tests/examples.js --lean",
    "test:boolean": "node tests/boolean.js",
    "test:replicate": "node tests/replicate.js",
    "test:action": "node tests/action.js",
    "test:gizmo": "node tests/gizmo.js",
    "test:ground": "node tests/ground.js",
    "test:animation": "node tests/animation.js",
    "test:waypoint": "node tests/waypoint.js",
    "test:html-texture": "node tests/html-texture.js",
    "test:waypoint-look": "node tests/waypoint-look.js",
    "test:opening": "node tests/opening.js",
    "test:doorways": "node tests/doorways.js",
    "test:wall-thickness": "node tests/wall-thickness.js",
    "test:unknown-type": "node tests/unknown-type.js",
    "test:unset-numbers": "node tests/unset-numbers.js",
    "test:webxr": "node tests/webxr.js",
    "test:sound": "node tests/sound.js",
    "test:walk": "node tests/walk.js",
    "test:follow": "node tests/follow.js",
    "test:named-animations": "node tests/named-animations.js",
    "test:near": "node tests/near.js",
    "test:lights": "node tests/lights.js",
    "test:arc-camera": "node tests/arc-camera.js",
    "test:shadow-casters": "node tests/shadow-casters.js",
    "test:weather": "node tests/weather.js",
    "test:marker": "node tests/marker.js",
    "test:look": "node tests/look.js",
    "test:thumbstick": "node tests/thumbstick.js",
    "test:cutaway": "node tests/cutaway.js",
    "test:characters": "node tests/characters.js",
    "test:nature": "node tests/nature.js",
    "test:nature-elements": "node tests/nature-elements.js",
    "test:model-skinned": "node tests/model-skinned.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jollify-Software/juel-garden.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Jollify-Software/juel-garden/issues"
  },
  "homepage": "https://github.com/Jollify-Software/juel-garden#readme",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "http-server": "^14.1.1",
    "playwright-core": "^1.48.2",
    "typedoc": "^0.28.20",
    "typescript": "5.9"
  },
  "dependencies": {
    "@babylonjs/core": "^8.56.2",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^8.56.2",
    "@swc/helpers": "^0.5.13",
    "cssjson": "^2.1.3",
    "earcut": "^3.0.0",
    "html2canvas": "^1.4.1",
    "lit": "^3.2.1",
    "rasterizehtml": "^1.3.0"
  }
}
